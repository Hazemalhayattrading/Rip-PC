        {
          "field": "coolerClearance",
          "text": "The product page lists 48 mm, which is spine setting 7; see layoutPositions for the other settings."
        },
        {
          "field": "gpuClearance",
          "text": "From \"Maximum GPU length: 322 mm (200 mm if installing a 120 mm radiator)\"."
        },
        {
          "field": "gpuMaxHeightMm",
          "text": "Fractal calls it \"GPU max width 145 mm\"."
        },
        {
          "field": "psu",
          "text": "SFX and SFX-L only, up to 130 mm: an ATX PSU does not fit."
        },
        {
          "field": "verticalGpuMount",
          "text": "The GPU sits on the far side of the spine; the product page says nothing about vertical mounting."
        },
        {
          "field": "includedFans",
          "text": "No fans are listed as included."
        },
        {
          "field": "frontIo",
